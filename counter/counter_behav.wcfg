<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="counter_behav.wdb" id="1">
         <top_modules>
            <top_module name="counter" />
            <top_module name="glbl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="3,737,398,030.000 ns"></ZoomStartTime>
      <ZoomEndTime time="3,737,398,703.001 ns"></ZoomEndTime>
      <Cursor1Time time="3,737,398,590.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="103"></NameColumnWidth>
      <ValueColumnWidth column_width="61"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="3" />
   <wvobject fp_name="/counter/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/counter/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
      <obj_property name="CustomSignalColor">#FAAFBE</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/counter/led" type="array">
      <obj_property name="ElementShortName">led[3:0]</obj_property>
      <obj_property name="ObjectShortName">led[3:0]</obj_property>
      <obj_property name="isExpanded"></obj_property>
   </wvobject>
</wave_config>
